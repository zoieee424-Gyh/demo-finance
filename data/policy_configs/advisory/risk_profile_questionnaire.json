{
  "meta": {
    "title": "投资者风险画像问卷",
    "version": "1.0.0",
    "created": "2026-06-06",
    "source": "基于证监会《证券期货投资者适当性管理办法》、基金业协会《基金募集机构投资者适当性管理实施指引》公开材料整理，结合通用投资者风险评估框架编写。本文件为测试预置资料，非监管原文。",
    "usage": "用于智能投顾智能体的用户风险画像解析（ProfileAnalyzer），帮助确定投资者的风险等级。",
    "disclaimer": "本问卷为通用框架参考，不替代持牌机构的正式风险评估。AI 不能决定用户风险等级，用户需自行确认评估结果。"
  },
  "risk_levels": {
    "conservative": {
      "label": "保守型",
      "min_score": 0,
      "max_score": 25,
      "description": "对本金安全性要求极高，不愿承担明显波动，适合以现金管理、短债等低风险资产为主的配置。"
    },
    "stable": {
      "label": "稳健型",
      "min_score": 26,
      "max_score": 50,
      "description": "可接受小幅波动以换取略高于通胀的回报，适合以固收为主、少量权益为辅的配置。"
    },
    "balanced": {
      "label": "平衡型",
      "min_score": 51,
      "max_score": 75,
      "description": "能承受中等波动，追求长期稳健增值，适合股债均衡配置。"
    },
    "aggressive": {
      "label": "进取型",
      "min_score": 76,
      "max_score": 100,
      "description": "追求较高长期回报，能承受显著回撤和波动，适合权益类资产占比较高的配置。"
    }
  },
  "dimensions": [
